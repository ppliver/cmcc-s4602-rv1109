# S4602 (CMCC 千里眼, RV1109 / SPI-NAND) 内核配置片段
# 用法：在 OpenIPC/linux 上先 `make rv1109_lite_defconfig`，再 `scripts/config --file .config -e/-d ...`
# 或直接 `make KCONFIG_CONFIG=...` 叠加。本片段只列「相对 rv1109_lite_defconfig 的增量」。
#
# 2026-11-11：设备假设为正常（跳过砖机恢复），目标 = 能引导、能挂载官方 nightly rootfs、
# 进 SSH。出图仍需 SC5338 驱动（见 docs/SC5338.md），本片段不含驱动源码。

# ---- 1) 强制内核命令行（绕过 U-Boot 注入的 rootfstype=squashfs 冲突）----
# 现场 7 次启动实证：U-Boot 始终注入 root=/dev/ubiblock0_0 rootfstype=squashfs ubi.mtd=9，
# setenv bootargs 无效。这里把正确 cmdline 写死进内核，CMDLINE_FORCE 让它覆盖一切来源。
CONFIG_CMDLINE_FORCE=y
CONFIG_CMDLINE="console=ttyFIQ0,1500000 earlycon=uart8250,mmio32,0xff570000 coherent_pool=1M net.ifnames=0 root=/dev/ubiblock0_0 rootfstype=squashfs ubi.mtd=8 rootwait"

# ---- 2) 命令行 MTD 分区表（与 U-Boot 14 分区一致，写死后内核自行建 /dev/mtdX）----
CONFIG_MTD_CMDLINE_PARTS=y
# 注意：mtdparts 通过 CONFIG_MTD_CMDLINE_PARTS 在 cmdline 里生效，上面 CMDLINE 已含完整串：
# spi-nand0:0x20000@0x0(gpt),0x100000@0x300000(uboot_a),0x100000@0x400000(uboot_b),
# 0x80000@0x500000(devinfo_a),0x80000@0x580000(devinfo_b),0x400000@0x600000(boot_a),
# 0x400000@0xa00000(boot_b),0x80000@0xe00000(misc),0x2c00000@0xe80000(system_a),
# 0x2c00000@0x3a80000(system_b),0x5a00000@0x6680000(model),0xf00000@0xc080000(log),
# 0x1800000@0xcf80000(data),0x17e0000@0xe780000(data_bk)
# ubi.mtd=8 → 挂 system_a（刷 _a 槽时）；刷 _b 槽改为 ubi.mtd=9。

# ---- 3) 存储栈（OpenIPC rv1109 默认已开，这里显式确认）----
CONFIG_MTD=y
CONFIG_MTD_SPI_NAND=y
CONFIG_RK_SFC_NAND=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BLOCK=y
CONFIG_UBIFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# ---- 4) 视频 / ISP 链路（RV1109 默认开，确认保留；SC5338 驱动仍缺）----
CONFIG_MEDIA_SUPPORT=y
CONFIG_V4L2_SUBDEV_API=y
CONFIG_VIDEO_ROCKCHIP_ISP=y
CONFIG_VIDEO_ROCKCHIP_RKCIF=y
CONFIG_VIDEO_ROCKCHIP_ISPP=y
CONFIG_PHY_ROCKCHIP_MIPI_RX=y
CONFIG_VIDEO_V4L2_SUBDEV=y

# ---- 5) 板载外设（原厂 DTB 用到）----
CONFIG_I2C_RK3X=y
CONFIG_RTC_DRV_PCF8563=y
# CONFIG_NET_RIONET is not set
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_SND_SOC_ES7202=y
CONFIG_LEDS_GPIO=y
CONFIG_GPIO_SYSFS=y
