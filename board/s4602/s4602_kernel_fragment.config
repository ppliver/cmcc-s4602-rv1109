# S4602 (CMCC 千里眼, RV1109 / SPI-NAND) 内核配置片段
# 用法：在 OpenIPC/linux 上先 `make rv1109_lite_defconfig`，再 `scripts/config --file .config -e/-d ...`
# 或直接 `make KCONFIG_CONFIG=...` 叠加。本片段只列「相对 rv1109_lite_defconfig 的增量」。
#
# 2026-11-11：设备假设为正常（跳过砖机恢复），目标 = 能引导、能挂载官方 nightly rootfs、
# 进 SSH。出图仍需 SC5338 驱动（见 docs/SC5338.md），本片段不含驱动源码。

# ---- 1) 强制内核命令行（绕过 U-Boot 注入的 rootfstype=squashfs 冲突）----
# 现场 7 次启动实证：U-Boot 始终强制注入 root=/dev/ubiblock0_0 rootfstype=squashfs ubi.mtd=9，
# setenv bootargs 无效。这里把正确 cmdline 写死进内核，CONFIG_CMDLINE_FORCE=y 让它覆盖一切来源。
# OpenIPC rootfs 是 UBIFS（不是原厂 squashfs），且本次刷 **_b 槽**（ubi.mtd=9 / system_b），
# 故必须为 ubi.mtd=9 + root=ubi0:rootfs rootfstype=ubifs。
# mtdparts 串依赖 CONFIG_MTD_CMDLINE_PARTS=y，必须一并写死（FORCE 之后 U-Boot 不再注入）。
CONFIG_CMDLINE_FORCE=y
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0xff570000 console=ttyFIQ0,1500000 ubi.mtd=9 root=ubi0:rootfs rootfstype=ubifs mtdparts=spi-nand0:0x20000@0x0(gpt),0x100000@0x300000(uboot_a),0x100000@0x400000(uboot_b),0x80000@0x500000(devinfo_a),0x80000@0x580000(devinfo_b),0x400000@0x600000(boot_a),0x400000@0xa00000(boot_b),0x80000@0xe00000(misc),0x2c00000@0xe80000(system_a),0x2c00000@0x3a80000(system_b),0x5a00000@0x6680000(model),0xf00000@0xc080000(log),0x1800000@0xcf80000(data),0x17e0000@0xe780000(data_bk)"

# ---- 2) 命令行 MTD 分区表（与 U-Boot 14 分区一致，写死后内核自行建 /dev/mtdX）----
CONFIG_MTD_CMDLINE_PARTS=y
# 上面的 CONFIG_CMDLINE 已含完整 mtdparts 串（spi-nand0:14 分区）；FORCE 后 U-Boot 注入的
# 同名串不再生效，此处是设备树/内核唯一的 mtdparts 来源。刷 _b 槽 → ubi.mtd=9 = system_b。

# ---- 3) 存储栈 ----
# 实测（CI run 43177394588 + 实机 RAM 启动日志 2026-11-12）：官方 rv1126.generic.config
# 已开 CONFIG_RK_FLASH / RK_SFC_NAND / RK_SFC_NAND_MTD / MTD_UBI / MTD_UBI_BLOCK。
# 不要开 CONFIG_MTD_SPI_NAND（通用 drivers/mtd/spi-nand，官方基线为 not set）：
#   Rockchip 板走的是自己的 drivers/rkflash，通用驱动既无必要也会引入变量。
# 缺的是 rkflash 的 SPI-NAND 芯片表：本机 flash id = e5 f2 e5，上游 spi_nand_tbl[]
# 没有该项 -> sfc_nand_init() 返回 FTL_UNSUPPORTED_FLASH -> 无 MTD 设备 ->
# UBI error: cannot open mtd 9 (-19)。表项由 tools/apply_kernel_patch.py 在 CI 注入。
CONFIG_MTD=y
CONFIG_RK_FLASH=y
CONFIG_RK_SFC_NAND=y
CONFIG_RK_SFC_NAND_MTD=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BLOCK=y
CONFIG_UBIFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# ---- 4) 视频 / ISP 链路（RV1109 默认开，确认保留）----
CONFIG_MEDIA_SUPPORT=y
# 本内核(4.19)子设备用户态 API 随 VIDEO_V4L2 无条件编译，没有单独的
# V4L2_SUBDEV_API 开关（旧 Kconfig 符号已不存在）；只需打开 MEDIA_CONTROLLER，
# 供 RKISP/RKCIF 的 media-controller 拓扑使用。
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_ROCKCHIP_ISP=y
CONFIG_VIDEO_ROCKCHIP_RKCIF=y
CONFIG_VIDEO_ROCKCHIP_ISPP=y
CONFIG_PHY_ROCKCHIP_MIPI_RX=y
CONFIG_VIDEO_V4L2_SUBDEV=y

# ---- 4b) SC5338 传感器驱动（S4602 板载 SmartSens SC5338，chip id 0xce50，2-lane MIPI）----
# 源码不在 OpenIPC/linux 树内，由 CI 在 make 前经 tools/apply_kernel_patch.py
# 拷入 drivers/media/i2c/ 并向 Makefile/Kconfig 注入；本片段只负责把符号编进内核。
CONFIG_VIDEO_SC5338=y

# ---- 5) 板载外设（原厂 DTB 用到）----
CONFIG_I2C_RK3X=y
CONFIG_RTC_DRV_PCF8563=y
# CONFIG_NET_RIONET is not set
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_ROCKCHIP=y
# ---- 5b) 外部 RMII PHY 驱动（S4602 板载外置 PHY，原厂疑似 YT8512B / Motorcomm）----
# 实机现象（2026-11-12 刷 _b 后）：eth0 已注册但 NO-CARRIER，udhcpc 拿不到租约；
# 原厂同硬件可正常联网出图（PoE + DHCP 均正常），排除线缆/交换机/PHY 硬件问题。
# OpenIPC 内核未编入专用 PHY 驱动，通用 ieee802.3-c22 驱动起不了该 PHY 的 RMII link。
# 把常见 RMII PHY 驱动编为内置（=y，启动即加载，不依赖模块自动加载）：
#   MOTORCOMM_PHY -> YT8512 / YT8521 / YT8531（本板最可疑）
#   REALTEK_PHY   -> RTL8201 系列（另一常见 RMII PHY）
#   MICREL_PHY    -> KSZ80xx 兜底
CONFIG_MOTORCOMM_PHY=y
CONFIG_REALTEK_PHY=y
CONFIG_MICREL_PHY=y
# CONFIG_SND_SOC_ES7202 必须保持关闭：官方基线为 not set。实机验证（2026-11-12）
# 打开后 es7202_probe() 在 i2c_transfer_buffer_flags 里 NULL deref，
# 0.42s 触发 Kernel panic - Fatal exception，内核根本起不来。
# 原厂 DTB 有 es7202 节点，但 OpenIPC 视频流不需要这块音频 ADC。
CONFIG_LEDS_GPIO=y
CONFIG_GPIO_SYSFS=y
