# S4602 kernel fragment for Firefly rv1126_defconfig (v2.2.5g / 4.19.111)
#
# Usage: make ARCH=arm rv1126_defconfig s4602_fragment.firefly.config
# or via build.sh with RK_KERNEL_DEFCONFIG_FRAGMENT=s4602_fragment.firefly.config
# placed at arch/arm/configs/.
#
# Baseline facts (verified 2026-11-17 against tag rv1126_rv1109/linux_release_v2.2.5g):
#   - rv1126_defconfig (370 lines) already has: MEDIA_SUPPORT, MEDIA_CONTROLLER,
#     VIDEO_ROCKCHIP_ISP/ISPP, RK_FLASH, RK_SFC_NAND(_MTD), MTD_UBI(_BLOCK),
#     UBIFS_FS, SQUASHFS(_XZ), STMMAC_ETH, I2C_RK3X; CMDLINE="user_debug=31".
#   - drivers/media/i2c/ has NO sc5338 (gc2053/imx307/imx415/ov5640/sc2335 only);
#     injected by tools/apply_kernel_patch.py before make.
#   - drivers/rkflash/sfc_nand.c has NO e5 f2 e5 entry; struct nand_info field
#     order matches our injection byte-for-byte (verified in this tag).
#   - drivers/net/phy/ has micrel.c/realtek.c, NO motorcomm.c; injected likewise.
#
# UNVERIFIED: whether CONFIG_VIDEO_ROCKCHIP_RKCIF exists as a symbol in this tree
# (defconfig grep found no RKCIF line; Kconfig symbol may be named differently).
# Build iteration: `grep -rni 'rkcif' kernel/drivers/media/platform/rockchip/cif/Kconfig`.

# ---- 1) Force kernel cmdline (vendor U-Boot force-injects root=...squashfs; we boot ubifs) ----
CONFIG_CMDLINE_FORCE=y
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0xff570000 console=ttyFIQ0,1500000 ubi.mtd=9 root=ubi0:rootfs rootfstype=ubifs mtdparts=spi-nand0:0x20000@0x0(gpt),0x100000@0x300000(uboot_a),0x100000@0x400000(uboot_b),0x80000@0x500000(devinfo_a),0x80000@0x580000(devinfo_b),0x400000@0x600000(boot_a),0x400000@0xa00000(boot_b),0x80000@0xe00000(misc),0x2c00000@0xe80000(system_a),0x2c00000@0x3a80000(system_b),0x5a00000@0x6680000(model),0xf00000@0xc080000(log),0x1800000@0xcf80000(data),0x17e0000@0xe780000(data_bk)"
CONFIG_MTD_CMDLINE_PARTS=y

# ---- 2) SC5338 sensor (injected driver) ----
CONFIG_VIDEO_SC5338=y

# ---- 3) External RMII PHY YT8512B (injected driver) ----
CONFIG_MOTORCOMM_PHY=y
CONFIG_REALTEK_PHY=y
CONFIG_MICREL_PHY=y

# ---- 4) Board peripherals used by vendor DTB ----
CONFIG_RTC_DRV_PCF8563=y
CONFIG_LEDS_GPIO=y
CONFIG_GPIO_SYSFS=y

# ---- 5) Slim kernel: drop display / audio / unused sensors ----
# rv1126 是开发板 defconfig，默认全开摄像头 IP 根本用不到的显示/音频，使 zImage 偏肥
# （实测 rv1126 defconfig 出 zboot.img 5.90 MiB > boot_b 4 MiB；OpenIPC 同代 4.19 仅 3.38 MiB）。
# 顶层关 → 级联关掉整棵子树；merge_config 里 "# CONFIG_X is not set" 覆盖 defconfig 的 =y。
# 安全边界：
#   - 出图必须保留：MEDIA_SUPPORT / VIDEO_ROCKCHIP_{CIF,ISP,ISPP} / I2C / SPI / STMMAC / UBI* —— 均不在此列。
#   - 音频裁掉 OK：本 fragment 走 CONFIG_CMDLINE_FORCE 自定义 cmdline，不含原厂的 snd_aloop.index=7。
#   - DRM 裁掉 OK：IP 无显示输出；ISP/ISPP 不硬依赖 DRM_KMS（GA 构建 olddefconfig 后校验 =y 仍在）。
#   - **USB 保留（2026-11-17 用户纠正）**：板上有 USB 口，后续要插 4G 无线网卡 RNDIS 模式，
#     host 子系统必须保留。见第 9 段补的 USB 网络驱动。gadget/configfs（本板当 USB 设备那侧）
#     与 4G 宿主无关，仍关闭省体积。
# CONFIG_DRM is not set
# CONFIG_DRM_ROCKCHIP is not set
# CONFIG_SND is not set
# CONFIG_SOUND is not set
# USB host 子系统不裁（保留 defconfig 的 USB=XHCI/EHCI/OHCI/STORAGE），只关设备角色：
# gadget/configfs 在 4.19 Kconfig 里是独立选项，关它们不影响 host（插 4G 卡是 host 角色）
# CONFIG_USB_GADGET is not set
# CONFIG_USB_CONFIGFS is not set
# 无用的参考板 sensor（我们用注入的 sc5338；MEDIA_SUBDRV_AUTOSELECT 未开，裁掉不牵连）
# CONFIG_VIDEO_IMX347 is not set
# CONFIG_VIDEO_IMX378 is not set
# CONFIG_VIDEO_OS04A10 is not set
# CONFIG_VIDEO_OV4689 is not set
# CONFIG_VIDEO_GC4C33 is not set

# ---- 6) Slim round 2: wireless / local block / input ----
# 网络摄像头 IP 走 STMMAC 有线网口，boot+rootfs 全在 SPI-NAND UBI，运行时不需要：
#   - WiFi/BT 栈与驱动（MAC80211/CFG80211/BT + Broadcom/RTL 芯片 + BCMA）—— 通常最大一块
#   - SCSI/MMC 本地块设备（rootfs 是 UBI，kernel 运行时不碰磁盘；SPI-NAND 走 SPI 总线不依赖 MMC/SCSI）
#   - 键盘/触摸/鼠标/HID 输入（保留 pwrkey + evdev：设备可能靠 evdev，电源键保留）
# 保留：NET/STMMAC/UBI/UBIFS/SQUASHFS/MEDIA/ISP/ISPP/SC5338 出图链路，CRYPTO 顶层（ubifs/squash 解压 + net 用到，不冒进）。
# 无线栈
# 关键：MAC80211/CFG80211 被 select 硬性拉回——menuconfig WLAN(default y) select WIRELESS；
# menuconfig WL_ROCKCHIP(rockchip_wlan) select CFG80211+MAC80211。select 优先级高于 "# is not set"，
# 故必须关 select 源头 WLAN/WL_ROCKCHIP，再补叶子双保险。
# CONFIG_WLAN is not set
# CONFIG_WL_ROCKCHIP is not set
# CONFIG_AP6XXX is not set
# CONFIG_MAC80211 is not set
# CONFIG_CFG80211 is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_BCMDHD is not set
# CONFIG_RTL_WIRELESS_SOLUTION is not set
# CONFIG_BCMA is not set
# 本地块设备
# CONFIG_SCSI is not set
# CONFIG_MMC is not set
# 输入子项（保留 INPUT / INPUT_EVDEV / INPUT_RK805_PWRKEY）
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_LEDS is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_INPUT_POLLDEV is not set
# CONFIG_HID is not set

# ---- 7) Slim round 3: crypto orphans + MPP decode + thermal/pstore/iio ----
# Round 2 (wireless/SCSI/MMC/input) took zboot 5.10 -> 4.33 MiB, still ~348 KB over 4 MiB.
# 相机 IP 无 wifi(TLS/AEAD)/解码/热调/Pstore，继续裁：
#  - CRYPTO：MAC80211 关后 ~25 个算法成孤儿（AEAD/BLKCIPHER/CCM/GCM/ECB/ARC4/
#    SEQIV/CMAC/RSA/ECDH/KPP/DRBG/CRYPTD 等）。保留核心 AES/SHA1/SHA256/SHA512/
#    LZO/CRC32C/HASH（ubifs/squash 解压 + hash 校验要用），顶层 CRYPTO 不关（net 依赖）。
#  - MPP 解码侧（只出不进）：裁 RKVDEC/VDPU2/IEP2；保留编码侧 RKVENC/VEPU2/MPP_SERVICE。
#  - 杂项：BACKLIGHT、PSTORE、IIO、DEVFREQ、THERMAL（相机无散热风扇/调光，且裁 thermal 不影响出图）。
# CRYPTO 孤儿算法（保留 CRYPTO/AES/SHA*/LZO/CRC32C/HASH/ALGAPI/WORKQUEUE/RNG/NULL）
# CONFIG_CRYPTO_AEAD is not set
# CONFIG_CRYPTO_AEAD2 is not set
# CONFIG_CRYPTO_ARC4 is not set
# CONFIG_CRYPTO_BLKCIPHER is not set
# CONFIG_CRYPTO_BLKCIPHER2 is not set
# CONFIG_CRYPTO_CCM is not set
# CONFIG_CRYPTO_CMAC is not set
# CONFIG_CRYPTO_CRYPTD is not set
# CONFIG_CRYPTO_CTR is not set
# CONFIG_CRYPTO_ECB is not set
# CONFIG_CRYPTO_ECDH is not set
# CONFIG_CRYPTO_DRBG is not set
# CONFIG_CRYPTO_DRBG_MENU is not set
# CONFIG_CRYPTO_DRBG_HMAC is not set
# CONFIG_CRYPTO_GCM is not set
# CONFIG_CRYPTO_SEQIV is not set
# CONFIG_CRYPTO_RSA is not set
# CONFIG_CRYPTO_KPP is not set
# CONFIG_CRYPTO_KPP2 is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set
# MPP 解码侧（相机只出不进；编码侧 RKVENC/VEPU2/SERVICE 保留）
# CONFIG_ROCKCHIP_MPP_RKVDEC is not set
# CONFIG_ROCKCHIP_MPP_VDPU2 is not set
# CONFIG_ROCKCHIP_MPP_IEP2 is not set
# 杂项（相机无背光/pstore/温度调风扇/模拟IO）
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_BACKLIGHT_PWM is not set
# CONFIG_PSTORE is not set
# CONFIG_PSTORE_CONSOLE is not set
# CONFIG_PSTORE_RAM is not set
# CONFIG_IIO is not set
# CONFIG_IIO_BUFFER is not set
# CONFIG_DEVFREQ_EVENT_ROCKCHIP_DFI is not set
# CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND is not set
# CONFIG_DEVFREQ_GOV_USERSPACE is not set
# CONFIG_DEVFREQ_THERMAL is not set
# CONFIG_ROCKCHIP_THERMAL is not set

# ---- 8) Slim round 4: switch kernel compression LZ4 -> XZ ----
# Round 3 后 zboot 仍 4.24 MiB（差 247 KB），且继续裁功能模块收益递减：
#   - 顶层 CRYPTO 被 44 处 `select`（含保留的 drivers/net/Kconfig），关不掉；
#     round3 实测裁 CRYPTO 孤儿几乎不省体积（大头是 MPP 解码，已裁）。
# 干净一刀：把内核体压缩从 LZ4 换 XZ。4.19 的 init/Kconfig 里 KERNEL_XZ 可用，
# 树内 XZ_DEC_ARM / XZ_DEC_ARMTHUMB / XZ_DEC_BCJ 已齐（BCJ 对 ARM 代码再压几个百分点）。
# XZ 体积比 LZ4 小约 20~30%，不裁任何功能（保留 MPP 解码 / 全部 crypto，给 Stage2 留余地），
# 代价仅启动解压 +1~2s —— 摄像头冷启动场景可接受。这是 choice 组，设 XZ=y 自动清同组其它。
# CONFIG_KERNEL_LZ4 is not set
CONFIG_KERNEL_XZ=y

# ---- 9) USB 4G 无线网卡（RNDIS）支持（2026-11-17 用户要求，恢复 host + 补数据驱动）----
# 板上有 USB 口，要插 4G 无线网卡 RNDIS 模式。defconfig 默认：
#   - host 子系统保留（XHCI/EHCI/OHCI/USB_STORAGE，defconfig 260-267 行）；
#   - 但 **没有任何 USB 网络驱动**（USB_USBNET/CDC/RNDIS/SERIAL 全 default off）。
# 光有 host 子系统，插上 4G 卡也识别不了 —— 必须把 4G 网卡数据口驱动补上。
# 4G 卡数据口常见走 RNDIS / CDC-NCM / CDC-Ethernet；管理/拨号口走 Option/Qualcomm/WWAN。
# 全用 =y 内建（固定设备，避免 rootfs 里放 .ko）。
# umbrella + 数据驱动（tristate，select/depends 关系已在 177 核对）
CONFIG_USB_USBNET=y
CONFIG_USB_NET_RNDIS_HOST=y      # RNDIS host（select USB_NET_CDCETHER，用户点名 RNDIS）
CONFIG_USB_NET_CDC_NCM=y         # CDC-NCM（多数 4G 卡数据口）
CONFIG_USB_NET_CDCETHER=y        # CDC-Ethernet（部分 4G 卡）
# 管理/拨号口（Option/Qualcomm 4G，会自动 select USB_SERIAL_WWAN）
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_WWAN=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_QUALCOMM=y
