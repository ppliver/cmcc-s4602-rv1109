2026-11-18T07:25:52.2265382Z func (w *WriteBuffer) Close() error {
2026-11-18T07:25:52.2266214Z 	// read w.Writer under the mutex - Reset may swap it concurrently
2026-11-18T07:25:52.2266661Z 	w.mu.Lock()
2026-11-18T07:25:52.2266897Z 	closer, _ := w.Writer.(io.Closer)
2026-11-18T07:25:52.2267166Z 	if closer == nil {
2026-11-18T07:25:52.2267505Z 		// mark the buffer as closed, so that late Write calls from track
2026-11-18T07:25:52.2268031Z 		// senders fail instead of writing into the http.ResponseWriter,
2026-11-18T07:25:52.2268534Z 		// whose bufio.Writer net/http recycles after the handler returns
2026-11-18T07:25:52.2268892Z 		if w.err == nil {
2026-11-18T07:25:52.2269820Z 			w.err = io.ErrClosedPipe
2026-11-18T07:25:52.2270199Z 		}
2026-11-18T07:25:52.2270507Z 		w.done()
2026-11-18T07:25:52.2270806Z 	}
2026-11-18T07:25:52.2271117Z 	w.mu.Unlock()
2026-11-18T07:25:52.2271380Z 	if closer != nil {
2026-11-18T07:25:52.2271619Z 		return closer.Close()
2026-11-18T07:25:52.2271835Z 	}
