			power-domains = <0x4d 0x11>;  /* 0x4d->&{/power-management@ff3e0000/power-controller}, 0x11->&{/vop@ffb00000/port/endpoint@0} */
			resets = <0x2 0xb5>;  /* 0x2->&{/clock-controller@ff490000}, 0xb5->&{/pinctrl/pcfg-pull-up} */
			reset-names = "usb3-otg";
			snps,dis_enblslpm_quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis_u2_susphy_quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,tx-ipgap-linecheck-dis-quirk;
			snps,tx-fifo-resize;
			snps,xhci-trb-ent-quirk;
			status = "okay";
			extcon = <0xb0>;
			phandle = <0x122>;
		};
