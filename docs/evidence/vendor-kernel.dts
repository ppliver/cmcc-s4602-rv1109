		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/key/key-reset}>;
		reset {
			gpios = <0x51 0x18 0x1>;
			linux,code = <0x73>;
			label = "GPIO Key VOLUMEUP";
			linux,input-type = <0x1>;
			wakeup-source;
			debounce-interval = <0x64>;
		};
	};
	rkacdc-dig-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,name = "rockchip,acdc-dig-sound";
		simple-audio-card,bitclock-master = <0xc1>;
		simple-audio-card,frame-master = <0xc1>;
		phandle = <0x12a>;
		simple-audio-card,cpu {
			sound-dai = <0xc2>;
			phandle = <0x12b>;
		};
		simple-audio-card,codec {
			sound-dai = <0xc3>;
			phandle = <0xc1>;
		};
	};
	es7202-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,format = "pdm";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,name = "rockchip,es7202-sound";
		phandle = <0x12c>;
		simple-audio-card,cpu {
			sound-dai = <0xc4>;
		};
		simple-audio-card,codec {
			sound-dai = <0xc5>;
		};
	};
