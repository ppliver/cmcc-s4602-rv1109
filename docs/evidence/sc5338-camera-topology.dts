endpoint {
	remote-endpoint = <&{/mipi-csi2@ffb10000/ports/port@1/endpoint@0}>;
	data-lanes = <0x1 0x2>;
	phandle = <0x85>;
};

/* /rkcif_mipi_lvds_sditf */
rkcif_mipi_lvds_sditf {
	compatible = "rockchip,rkcif-sditf";
	rockchip,cif = <0x19>;
	status = "okay";
	phandle = <0xcf>;
	port {
		endpoint {
			remote-endpoint = <&{/rkisp-vir0/ports/port@0/endpoint@0}>;
			data-lanes = <0x1 0x2>;
			phandle = <0x8c>;
		};
	};
};

