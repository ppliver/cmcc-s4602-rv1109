/* SC5338 摄像头链路节点摘录 —— 来源 docs/evidence/vendor-kernel.dtb
   DTB 85937 B / md5 2e96cb2dd8321c19425b73490586bb01
   共 441 个节点，命中 72 个摄像头相关节点。
   每个片段前的注释是节点在 DTB 里的完整路径，片段本身可直接抄进目标 DTS。 */

/* /aliases */
aliases {
	ethernet0 = "/ethernet@ffc40000";
	i2c0 = "/i2c@ff3f0000";
	i2c1 = "/i2c@ff510000";
	i2c2 = "/i2c@ff400000";
	i2c3 = "/i2c@ff520000";
	i2c4 = "/i2c@ff530000";
	i2c5 = "/i2c@ff540000";
	mmc0 = "/dwmmc@ffc50000";
	mmc1 = "/dwmmc@ffc70000";
	mmc2 = "/dwmmc@ffc60000";
	serial0 = "/serial@ff560000";
	serial1 = "/serial@ff410000";
	serial2 = "/serial@ff570000";
	serial3 = "/serial@ff580000";
	serial4 = "/serial@ff590000";
	serial5 = "/serial@ff5a0000";
	spi0 = "/spi@ff450000";
	spi1 = "/spi@ff5b0000";
	dphy0 = "/csi-dphy@ff4b0000";
	dphy1 = "/csi-dphy@ff4b8000";
};

/* /display-subsystem */
display-subsystem {
	compatible = "rockchip,display-subsystem";
	ports = <0xe>;
	status = "okay";
	logo-memory-region = <0xf>;
	phandle = <0xc7>;
	route {
		route-dsi {
			status = "disabled";
			logo,uboot = "logo.bmp";
			logo,kernel = "logo_kernel.bmp";
			logo,mode = "center";
			charge_logo,mode = "center";
			connect = <0x10>;
			phandle = <0xc8>;
		};
		route-rgb {
			status = "disabled";
			logo,uboot = "logo.bmp";
			logo,kernel = "logo_kernel.bmp";
			logo,mode = "center";
			charge_logo,mode = "center";
			connect = <0x11>;
			phandle = <0xc9>;
		};
	};
};

/* /display-subsystem/route */
route {
	route-dsi {
		status = "disabled";
		logo,uboot = "logo.bmp";
		logo,kernel = "logo_kernel.bmp";
		logo,mode = "center";
		charge_logo,mode = "center";
		connect = <0x10>;
		phandle = <0xc8>;
	};
	route-rgb {
		status = "disabled";
		logo,uboot = "logo.bmp";
		logo,kernel = "logo_kernel.bmp";
		logo,mode = "center";
		charge_logo,mode = "center";
		connect = <0x11>;
		phandle = <0xc9>;
	};
};

/* /display-subsystem/route/route-dsi */
route-dsi {
	status = "disabled";
	logo,uboot = "logo.bmp";
	logo,kernel = "logo_kernel.bmp";
	logo,mode = "center";
	charge_logo,mode = "center";
	connect = <0x10>;
	phandle = <0xc8>;
};

/* /display-subsystem/route/route-rgb */
route-rgb {
	status = "disabled";
	logo,uboot = "logo.bmp";
	logo,kernel = "logo_kernel.bmp";
	logo,mode = "center";
	charge_logo,mode = "center";
	connect = <0x11>;
	phandle = <0xc9>;
};

/* /reserved-memory/isp */
isp {
	compatible = "shared-dma-pool";
	inactive;
	reusable;
	size = "", "", "", "";
	phandle = <0x13>;
};

/* /rkcif_dvp */
rkcif_dvp {
	compatible = "rockchip,rkcif-dvp";
	rockchip,hw = <0x12>;
	memory-region = <0x13>;
	status = "disabled";
	phandle = <0x14>;
};

