		phandle = <0x8c>;
	};
};

/* /rkcif_mipi_lvds_sditf/port/endpoint */
endpoint {
	remote-endpoint = <&{/rkisp-vir0/ports/port@0/endpoint@0}>;
	data-lanes = <0x1 0x2>;
	phandle = <0x8c>;
};

/* /thermal-zones/cpu-thermal */
cpu-thermal {
	polling-delay-passive = <0x14>;
	polling-delay = <0x3e8>;
	sustainable-power = <0x36b>;
	k_pu = <0x4b>;
	k_po = <0xaf>;
	k_i = "", "", "", "";
	thermal-sensors = <0x1b 0x0>;
	phandle = <0xd3>;
	trips {
		trip-point-0 {
			temperature = <0x124f8>;
			hysteresis = <0x7d0>;
			type = "passive";
			phandle = <0xd4>;
		};
		trip-point-1 {
			temperature = <0x14c08>;
			hysteresis = <0x7d0>;
			type = "passive";
			phandle = <0x1c>;
		};
		soc-crit {
			temperature = <0x1e848>;
			hysteresis = <0x7d0>;
			type = "critical";
			phandle = <0xd5>;
		};
	};
	cooling-maps {
		map0 {
			trip = <0x1c>;
			cooling-device = <0xa 0xffffffff 0xffffffff>;
			contribution = <0x400>;
		};
		map1 {
			trip = <0x1c>;
			cooling-device = <0x1d 0xffffffff 0xffffffff>;
			contribution = <0x400>;
		};
		map2 {
			trip = <0x1c>;
			cooling-device = <0x1e 0xffffffff 0xffffffff>;
			contribution = <0x424>;
		};
	};
};

/* /thermal-zones/npu-thermal */
npu-thermal {
	polling-delay-passive = <0x14>;
	polling-delay = <0x3e8>;
	sustainable-power = <0x3d1>;
	thermal-sensors = <0x1f 0x0>;
	phandle = <0xd6>;
};

/* /power-management@ff3e0000/power-controller/pd_ispp@11 */
pd_ispp@11 {
	reg = <0xb>;
	clocks = <0x2 0xba 0x2 0xe1 0x2 0x6b>;  /* 0x2->&{/clock-controller@ff490000}, 0xba->&{/pinctrl/pcfg-output-low}, 0x2->&{/clock-controller@ff490000}, 0xe1->&{/pwm@ff430000}, 0x2->&{/clock-controller@ff490000}, 0x6b->&{/otp@ff5c0000/tsadc-trim-base@27} */
	pm_qos = <0x2e 0x2f>;
};

/* /csi-dphy@ff4b0000 */
csi-dphy@ff4b0000 {
	compatible = "rockchip,rv1126-csi-dphy";
	reg = <0xff4b0000 0x8000>;
	clocks = <0x2 0x122>;  /* 0x2->&{/clock-controller@ff490000}, 0x122->&{/usb0/dwc3@ffd00000} */
	clock-names = "pclk";
	rockchip,grf = <0x48>;
	status = "okay";
	phandle = <0xea>;
	ports {
		#address-cells = <0x1>;
		#size-cells = "", "", "", "";
		port@0 {
			reg = "", "", "", "";
			#address-cells = <0x1>;
			#size-cells = "", "", "", "";
			endpoint@1 {
				reg = <0x1>;
				remote-endpoint = <&{/i2c@ff510000/sc5338@30/port/endpoint}>;
				data-lanes = <0x1 0x2>;
				phandle = <0x52>;
			};
		};
		port@1 {
			reg = <0x1>;
			#address-cells = <0x1>;
			#size-cells = "", "", "", "";
			endpoint@0 {
				reg = "", "", "", "";
				remote-endpoint = <&{/mipi-csi2@ffb10000/ports/port@0/endpoint@1}>;
				data-lanes = <0x1 0x2>;
				phandle = <0x84>;
			};
		};
	};
};

/* /csi-dphy@ff4b0000/ports */
ports {
	#address-cells = <0x1>;
	#size-cells = "", "", "", "";
	port@0 {
		reg = "", "", "", "";
		#address-cells = <0x1>;
		#size-cells = "", "", "", "";
		endpoint@1 {
			reg = <0x1>;
			remote-endpoint = <&{/i2c@ff510000/sc5338@30/port/endpoint}>;
			data-lanes = <0x1 0x2>;
			phandle = <0x52>;
		};
	};
	port@1 {
		reg = <0x1>;
		#address-cells = <0x1>;
		#size-cells = "", "", "", "";
		endpoint@0 {
			reg = "", "", "", "";
			remote-endpoint = <&{/mipi-csi2@ffb10000/ports/port@0/endpoint@1}>;
			data-lanes = <0x1 0x2>;
			phandle = <0x84>;
		};
	};
};

