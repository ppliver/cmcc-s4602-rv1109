port@0 {
	reg = "", "", "", "";
	#address-cells = <0x1>;
	#size-cells = "", "", "", "";
	endpoint@1 {
		reg = <0x1>;
		remote-endpoint = <&{/i2c@ff510000/sc5338@30/port/endpoint}>;
		data-lanes = <0x1 0x2>;
		phandle = <0x52>;
	};
};

/* /csi-dphy@ff4b0000/ports/port@0/endpoint@1 */
endpoint@1 {
	reg = <0x1>;
	remote-endpoint = <&{/i2c@ff510000/sc5338@30/port/endpoint}>;
	data-lanes = <0x1 0x2>;
	phandle = <0x52>;
};

/* /csi-dphy@ff4b0000/ports/port@1 */
port@1 {
	reg = <0x1>;
	#address-cells = <0x1>;
	#size-cells = "", "", "", "";
	endpoint@0 {
		reg = "", "", "", "";
		remote-endpoint = <&{/mipi-csi2@ffb10000/ports/port@0/endpoint@1}>;
		data-lanes = <0x1 0x2>;
		phandle = <0x84>;
	};
};

/* /csi-dphy@ff4b0000/ports/port@1/endpoint@0 */
endpoint@0 {
	reg = "", "", "", "";
	remote-endpoint = <&{/mipi-csi2@ffb10000/ports/port@0/endpoint@1}>;
	data-lanes = <0x1 0x2>;
	phandle = <0x84>;
};

/* /csi-dphy@ff4b8000 */
csi-dphy@ff4b8000 {
	compatible = "rockchip,rv1126-csi-dphy";
	reg = <0xff4b8000 0x8000>;
	clocks = <0x2 0x123>;  /* 0x2->&{/clock-controller@ff490000}, 0x123->&{/usb@ffe00000} */
	clock-names = "pclk";
	rockchip,grf = <0x48>;
	status = "disabled";
	phandle = <0xeb>;
};

/* /mipi-dphy@ff4d0000 */
mipi-dphy@ff4d0000 {
	compatible = "rockchip,rv1126-mipi-dphy", "rockchip,rk1808-mipi-dphy";
	reg = <0xff4d0000 0x500>;
	assigned-clocks = <0x38 0x1a>;  /* 0x38->&{/clock-controller@ff480000}, 0x1a->&{/rkisp-vir0/ports/port@0/endpoint@0} */
	assigned-clock-rates = <0x16e3600>;
	clocks = <0x38 0x1a 0x2 0x121>;  /* 0x38->&{/clock-controller@ff480000}, 0x1a->&{/rkisp-vir0/ports/port@0/endpoint@0}, 0x2->&{/clock-controller@ff490000}, 0x121->&{/usb0} */
	clock-names = "ref", "pclk";
	clock-output-names = "mipi_dphy_pll";
	#clock-cells = "", "", "", "";
	resets = <0x2 0xe6>;  /* 0x2->&{/clock-controller@ff490000}, 0xe6->&{/pwm@ff440010} */
	reset-names = "apb";
	#phy-cells = "", "", "", "";
	rockchip,grf = <0x48>;
	status = "disabled";
	phandle = <0x88>;
};

/* /i2c@ff510000/sc5338@30 */
sc5338@30 {
	compatible = "smartsens,sc5338";
	reg = <0x30>;
	clocks = <0x2 0x67>;  /* 0x2->&{/clock-controller@ff490000}, 0x67->&{/pinctrl/spi1/spi1m0-pins} */
	clock-names = "xvclk";
	power-domains = <0x4d 0x9>;  /* 0x4d->&{/power-management@ff3e0000/power-controller}, 0x9->&{/otp@ff5c0000/cpu-code@2} */
	pinctrl-names = "rockchip,camera_default";
	pinctrl-0 = <&{/pinctrl/mipicsi/mipicsi-clk0}>;
	avdd-supply = <&{/vcc33sys}>;
	dovdd-supply = <&{/vcc-1v8}>;
	dvdd-supply = <&{/vcc-dvdd}>;
	pwdn-gpios = <0x51 0x1c 0x0>;
	reset-gpios = <0x51 0x1d 0x0>;
	rockchip,camera-module-index = <0x1>;
	rockchip,camera-module-facing = "front";
	rockchip,camera-module-name = "CMK-OT1607-FV1";
	rockchip,camera-module-lens-name = "M12-40IRC-4MP-F16";
	phandle = <0xef>;
	port {
		endpoint {
			remote-endpoint = <&{/csi-dphy@ff4b0000/ports/port@0/endpoint@1}>;
			data-lanes = <0x1 0x2>;
			phandle = <0x49>;
		};
	};
};

/* /i2c@ff510000/sc5338@30/port */
port {
	endpoint {
		remote-endpoint = <&{/csi-dphy@ff4b0000/ports/port@0/endpoint@1}>;
		data-lanes = <0x1 0x2>;
		phandle = <0x49>;
	};
};

/* /i2c@ff510000/sc5338@30/port/endpoint */
endpoint {
	remote-endpoint = <&{/csi-dphy@ff4b0000/ports/port@0/endpoint@1}>;
	data-lanes = <0x1 0x2>;
	phandle = <0x49>;
};

/* /i2c@ff510000/sc530ai@30 */
sc530ai@30 {
	compatible = "smartsens,sc530ai";
	reg = <0x30>;
	clocks = <0x2 0x67>;  /* 0x2->&{/clock-controller@ff490000}, 0x67->&{/pinctrl/spi1/spi1m0-pins} */
	clock-names = "xvclk";
	power-domains = <0x4d 0x9>;  /* 0x4d->&{/power-management@ff3e0000/power-controller}, 0x9->&{/otp@ff5c0000/cpu-code@2} */
	pinctrl-names = "rockchip,camera_default";
	pinctrl-0 = <&{/pinctrl/mipicsi/mipicsi-clk0}>;
	avdd-supply = <&{/vcc33sys}>;
	dovdd-supply = <&{/vcc-1v8}>;
	dvdd-supply = <&{/vcc-dvdd}>;
	pwdn-gpios = <0x51 0x1c 0x0>;
	reset-gpios = <0x51 0x1d 0x0>;
	rockchip,camera-module-index = <0x1>;
	rockchip,camera-module-facing = "front";
	rockchip,camera-module-name = "CMK-OT1607-FV1";
	rockchip,camera-module-lens-name = "M12-40IRC-4MP-F16";
	phandle = <0xf0>;
};

/* /i2c@ff510000/sc401ai@30 */
sc401ai@30 {
	compatible = "smartsens,sc401ai";
	reg = <0x30>;
	clocks = <0x2 0x67>;  /* 0x2->&{/clock-controller@ff490000}, 0x67->&{/pinctrl/spi1/spi1m0-pins} */
	clock-names = "xvclk";
	power-domains = <0x4d 0x9>;  /* 0x4d->&{/power-management@ff3e0000/power-controller}, 0x9->&{/otp@ff5c0000/cpu-code@2} */
	pinctrl-names = "rockchip,camera_default";
	pinctrl-0 = <&{/pinctrl/mipicsi/mipicsi-clk0}>;
	avdd-supply = <&{/vcc33sys}>;
	dovdd-supply = <&{/vcc-1v8}>;
	dvdd-supply = <&{/vcc-dvdd}>;
	pwdn-gpios = <0x51 0x1c 0x0>;
	reset-gpios = <0x51 0x1d 0x0>;
	rockchip,camera-module-index = <0x1>;
	rockchip,camera-module-facing = "front";
	rockchip,camera-module-name = "CMK-OT1607-FV1";
	rockchip,camera-module-lens-name = "M12-40IRC-4MP-F16";
	phandle = <0xf1>;
};

/* /tsadc@ff5f0000 */
tsadc@ff5f0000 {
	compatible = "rockchip,rv1126-tsadc";
	reg = <0xff5f0000 0x100>;
	rockchip,grf = <0x48>;
	interrupts = <0x0 0x27 0x4>;
	assigned-clocks = <0x2 0x36>;  /* 0x2->&{/clock-controller@ff490000}, 0x36->&{/qos@fe810000} */
	assigned-clock-rates = <0x3d0900>;
	clocks = <0x2 0x36 0x2 0x10f 0x2 0x37>;  /* 0x2->&{/clock-controller@ff490000}, 0x36->&{/qos@fe810000}, 0x2->&{/clock-controller@ff490000}, 0x10f->&{/iep@ffb20000}, 0x2->&{/clock-controller@ff490000}, 0x37->&{/qos@fe810080} */
	clock-names = "tsadc", "apb_pclk", "phy_clk";
	resets = <0x2 0xe8 0x2 0xe9 0x2 0xea>;  /* 0x2->&{/clock-controller@ff490000}, 0xe8->&{/pwm@ff440030}, 0x2->&{/clock-controller@ff490000}, 0xe9->&{/spi@ff450000}, 0x2->&{/clock-controller@ff490000}, 0xea->&{/csi-dphy@ff4b0000} */
	reset-names = "tsadc-apb", "tsadc", "tsadc-phy";
	rockchip,hw-tshut-temp = <0x1d4c0>;
	#thermal-sensor-cells = <0x1>;
	nvmem-cells = <0x69 0x6a 0x6b>;
	nvmem-cell-names = "trim_l", "trim_h", "trim_base";
	rockchip,hw-tshut-mode = "", "", "", "";
	rockchip,hw-tshut-polarity = "", "", "", "";
	pinctrl-names = "gpio", "otpout";
	pinctrl-0 = <&{/pinctrl/tsadc/tsadcm0-shut}>;
	pinctrl-1 = <&{/pinctrl/tsadc/tsadc-shutorg}>;
	status = "okay";
	phandle = <0x1b>;
};

/* /tsadc@ff5f8000 */
tsadc@ff5f8000 {
	compatible = "rockchip,rv1126-tsadc";
	reg = <0xff5f8000 0x100>;
	rockchip,grf = <0x48>;
	interrupts = <0x0 0x71 0x4>;
	assigned-clocks = <0x2 0x34>;  /* 0x2->&{/clock-controller@ff490000}, 0x34->&{/qos@fe860200} */
	assigned-clock-rates = <0x3d0900>;
	clocks = <0x2 0x34 0x2 0x10e 0x2 0x35>;  /* 0x2->&{/clock-controller@ff490000}, 0x34->&{/qos@fe860200}, 0x2->&{/clock-controller@ff490000}, 0x10e->&{/mipi-csi2@ffb10000}, 0x2->&{/clock-controller@ff490000}, 0x35->&{/qos@fe86c000} */
	clock-names = "tsadc", "apb_pclk", "phy_clk";
	resets = <0x2 0xd8 0x2 0xd9 0x2 0xda>;  /* 0x2->&{/clock-controller@ff490000}, 0xd8->&{/dummy_cpll}, 0x2->&{/clock-controller@ff490000}, 0xd9->&{/external-gmac-clockm0}, 0x2->&{/clock-controller@ff490000}, 0xda->&{/external-gmac-clockm1} */
	reset-names = "tsadc-apb", "tsadc", "tsadc-phy";
	rockchip,hw-tshut-temp = <0x1d4c0>;
	#thermal-sensor-cells = <0x1>;
	nvmem-cells = <0x6e 0x6f 0x6b>;
	nvmem-cell-names = "trim_l", "trim_h", "trim_base";
	rockchip,hw-tshut-mode = "", "", "", "";
	rockchip,hw-tshut-polarity = "", "", "", "";
	pinctrl-names = "gpio", "otpout";
	pinctrl-0 = <&{/pinctrl/tsadc/tsadcm0-shut}>;
	pinctrl-1 = <&{/pinctrl/tsadc/tsadc-shutorg}>;
	status = "okay";
	phandle = <0x1f>;
};

/* /rkcif@ffae0000 */
rkcif@ffae0000 {
	compatible = "rockchip,rv1126-cif";
	reg = <0xffae0000 0x8000>;
	reg-names = "cif_regs";
	interrupts = <0x0 0x3a 0x4>;
	interrupt-names = "cif-intr";
	clocks = <0x2 0xb5 0x2 0xde 0x2 0x9b>;  /* 0x2->&{/clock-controller@ff490000}, 0xb5->&{/pinctrl/pcfg-pull-up}, 0x2->&{/clock-controller@ff490000}, 0xde->&{/i2c@ff3f0000}, 0x2->&{/clock-controller@ff490000}, 0x9b->&{/ethernet@ffc40000/rx-queues-config} */
	clock-names = "aclk_cif", "hclk_cif", "dclk_cif";
	resets = <0x2 0x94 0x2 0x95 0x2 0x96 0x2 0x97 0x2 0x98 0x2 0x99>;  /* 0x2->&{/clock-controller@ff490000}, 0x94->&{/iommu@ffb80480}, 0x2->&{/clock-controller@ff490000}, 0x95->&{/iommu@ffb90800}, 0x2->&{/clock-controller@ff490000}, 0x96->&{/rkvenc-opp-table}, 0x2->&{/clock-controller@ff490000}, 0x97->&{/iommu@ffbb0f00}, 0x2->&{/clock-controller@ff490000}, 0x98->&{/otp@ff5c0000/venc-leakage@1a}, 0x2->&{/clock-controller@ff490000}, 0x99->&{/otp@ff5c0000/venc-performance@1f} */
	reset-names = "rst_cif_a", "rst_cif_h", "rst_cif_d", "rst_cif_p", "rst_cif_i", "rst_cif_rx_p";
	assigned-clocks = <0x2 0x9b>;  /* 0x2->&{/clock-controller@ff490000}, 0x9b->&{/ethernet@ffc40000/rx-queues-config} */
	assigned-clock-rates = <0x11e1a300>;
	power-domains = <0x4d 0x9>;  /* 0x4d->&{/power-management@ff3e0000/power-controller}, 0x9->&{/otp@ff5c0000/cpu-code@2} */
	rockchip,grf = <0x48>;
	status = "okay";
	iommus = <&{/iommu@ffae0800}>;
	phandle = <0x12>;
};

